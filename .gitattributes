# Fins de ligne : LF partout dans le dépôt (évite les fausses modifications
# LF/CRLF créées par les éditeurs Windows), sauf les scripts Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires (jamais convertis)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.ogg binary
*.wav binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
